# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais commiter .env.local.

# Base de données
DATABASE_URL=postgres://user:password@localhost:5432/fcfabtc

# Bitnob (app.bitnob.com → Settings → API Keys). Auth HMAC, voir src/lib/bitnob.ts
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# Secret de signature des webhooks (à confirmer dans le dashboard / avec les mentors)
BITNOB_WEBHOOK_SECRET=

# App
APP_URL=http://localhost:3000
CRON_SECRET=un-long-secret-aleatoire
QUOTE_TTL_MINUTES=15
INVOICE_TTL_MINUTES=10
SERVICE_FEE_PERCENT=1.5
NEXT_PUBLIC_MIN_FCFA=500
# Plafond prudent tant que l'argent est réel ; à relever après les premiers transferts
NEXT_PUBLIC_MAX_FCFA=10000

# Sandbox uniquement : bouton « Simuler le paiement ». Ignoré si les clés sont en production.
SANDBOX_SIMULATION=false
